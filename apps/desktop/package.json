{
  "name": "desktop",
  "private": true,
  "version": "0.6.45",
  "license": "MIT",
  "description": "Engram — a self-organizing knowledge vault with an AI librarian",
  "author": "YunJae Kwon",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "bundle:binaries": "node scripts/bundle-binaries.mjs",
    "dist": "electron-vite build && node scripts/bundle-binaries.mjs && electron-builder --publish never && node scripts/verify-feed.mjs",
    "smoke:clean-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-clean-env.ps1",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@huggingface/transformers": "^4.2.0",
    "@openai/codex-sdk": "^0.150.1",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "zod": "^4.0.0",
    "npm": "^10.9.8",
    "playwright-core": "^1.61.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/merge": "^6.7.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.35.0",
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.0",
    "cmdk": "^1.0.0",
    "core": "workspace:*",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.23.0",
    "marked": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
