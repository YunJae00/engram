{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brief.schema.json",
  "title": "brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "area", "difficulty", "goal", "facts", "criteria", "allowedFiles", "outOfScope"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "area": { "type": "string", "enum": ["ts", "native"] },
    "difficulty": { "type": "string", "enum": ["easy", "hard"] },
    "repeat": { "type": "boolean" },
    "goal": { "type": "string" },
    "facts": { "type": "array", "items": { "type": "string" } },
    "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/criterion" } },
    "allowedFiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "outOfScope": { "type": "array", "items": { "type": "string" } },
    "scenarios": { "type": "array", "items": { "type": "string" } },
    "design": { "type": "string" }
  },
  "definitions": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cmd", "expect"],
      "properties": {
        "id": { "type": "string" },
        "cmd": { "type": "string" },
        "expect": { "type": "string" }
      }
    }
  }
}
