{
  "name": "engram-monorepo",
  "private": true,
  "version": "0.8.91",
  "description": "A second brain that keeps your memories on your machine",
  "author": "YunJae Kwon",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current"],
      "cpu": ["x64", "arm64"]
    },
    "onlyBuiltDependencies": [
      "canvas",
      "electron",
      "esbuild",
      "tesseract.js"
    ],
    "overrides": {
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "fast-uri": "^3.1.4",
      "tar": ">=7.5.21",
      "adm-zip": ">=0.6.0"
    }
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run todo-scan && pnpm run css-scan",
    "check:quick": "node scripts/check-quick.mjs",
    "verify": "node scripts/check-quick.mjs && pnpm --filter desktop build && node scripts/e2e-affected.mjs",
    "eval:quick": "cd apps/desktop && node ../../packages/core/node_modules/tsx/dist/cli.mjs scripts/eval-quick.mts",
    "verify:release": "pnpm run check && pnpm run test:e2e",
    "test:e2e:fast": "pnpm --filter desktop test:e2e:fast",
    "e2e:affected": "pnpm --filter desktop build && node scripts/e2e-affected.mjs",
    "dev": "pnpm --filter desktop dev",
    "dist": "pnpm --filter desktop dist",
    "smoke:clean-env": "pnpm --filter desktop smoke:clean-env",
    "test:e2e": "pnpm --filter desktop test:e2e",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --cache --cache-strategy content --cache-location tmp/eslint.cache",
    "test": "vitest run --project unit && vitest run --project timing --no-file-parallelism",
    "todo-scan": "node scripts/todo-scan.mjs",
    "css-scan": "node scripts/css-orphan-scan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
